{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "routes": [
    { "src": "/(.*)", "headers": { "X-Robots-Tag": "noindex" }, "continue": true },
    { "src": "/moscow", "headers": { "Location": "/moscow/" }, "status": 308 },
    { "src": "/moscow/", "dest": "/moscow/index.html" },
    { "src": "/minsk", "headers": { "Location": "/minsk/" }, "status": 308 },
    { "src": "/minsk/", "dest": "/minsk/index.html" },
    { "handle": "filesystem" },
    { "src": "/moscow/(.*)", "dest": "/moscow/404.html", "status": 404 },
    { "src": "/minsk/(.*)", "dest": "/minsk/404.html", "status": 404 },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
